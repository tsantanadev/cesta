<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal links: cesta.tsantana.dev serves the apple-app-site-association
	     (hosting/public/.well-known) that hands /invite/* to the app. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:cesta.tsantana.dev</string>
	</array>
</dict>
</plist>
